    {
      "id": "card-deck",
      "name": "Card deck",
      "direction": "output",
      "kind": "interface",
      "type": "ae/card-deck",
      "version": "1.0.0"
    }
  ],
  "settings": [
    {
      "id": "decks",
      "name": "Decks",
      "type": "number",
      "required": false,
      "secret": false,
      "default": 1
    },
    {
      "id": "jokers",
      "name": "Jokers",
      "type": "boolean",
      "required": false,
      "secret": false,
      "default": false
    }
  ]
}
